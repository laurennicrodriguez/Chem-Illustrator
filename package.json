{
  "name": "chem-illustrator",
  "version": "0.1.0",
  "description": "Fast chemical structure drawing for the lab, in the style of ChemDraw",
  "scripts": {
    "postinstall": "node scripts/copy-rdkit.mjs",
    "predev": "node scripts/copy-rdkit.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-rdkit.mjs",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "bench": "node bench/perf.mjs stress",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "keywords": [],
  "author": "Nathan O'Hare",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "~2.12.1",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@rdkit/rdkit": "^2026.9.1",
    "@tauri-apps/api": "~2.12.1",
    "@tauri-apps/plugin-dialog": "~2.8.2",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.13.3",
    "fflate": "^0.8.2",
    "polygon-clipping": "^0.15.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
