{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chem Illustrator",
  "version": "0.1.0",
  "identifier": "io.github.nathanohare.chemillustrator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Chem Illustrator",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.crossref.org"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Fast chemical structure drawing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "science"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFQkQwODY3OTYxRTlFRjAKUldUd25oNldad2k5UHFxS1B6T3VMbHlmR29MdEhjd2ZOeERiZXlKWU1HOVphbytwbVFuVGVSMXIK",
      "endpoints": [
        "https://github.com/nathanohare/Chem-Illustrator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
